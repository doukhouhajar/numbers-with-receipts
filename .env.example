# copy to .env and fill in

# LLM Provider
# "ollama" (local)
LLM_PROVIDER=ollama
GROUNDWORK_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# If you use OpenRouter as I did
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GROUNDWORK_MODEL=meta-llama/llama-3.3-70b-instruct

# E2B: sandboxed code execution
E2B_API_KEY=

# Langfuse for observability 
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# app
GROUNDWORK_ENV=dev
LOG_LEVEL=INFO
