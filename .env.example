# Copy to .env and fill in. Every key here is optional — with none set, the agent
# still runs: the parser falls back to regex and tracing is simply disabled.

# ── LLM provider ────────────────────────────────────────────────────────────
# "ollama" (default, local) or "openai-compatible" (vLLM / hosted / any OpenAI API)
LLM_PROVIDER=ollama
GROUNDWORK_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# For LLM_PROVIDER=openai-compatible, point at any OpenAI-style endpoint:
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=sk-...

# ── Sandboxed code execution (E2B) ──────────────────────────────────────────
# Only needed for the sandbox tool. Get a key at https://e2b.dev
E2B_API_KEY=

# ── Observability (Langfuse) ────────────────────────────────────────────────
# Leave blank to run untraced. https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── App ─────────────────────────────────────────────────────────────────────
GROUNDWORK_ENV=dev
LOG_LEVEL=INFO
